/* 8. Grid layout */
.grid {
    display: grid;
    grid-template-columns: 40% 40%;
    justify-content: space-around;
    align-items: start;
    row-gap: 20px;
}

/* 9. Hình ảnh bên trong grid */
.grid img {
    width: 100%;
}

/* 10. Flex layout */
.flex {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-around;
}

/* 11. H1 */
h1 {
    text-align: center;
    font-family: Georgia, "Times New Roman", serif;
    color: #17365d;
}

/* 12. Paragraph */
p {
    line-height: 1.6;
}
