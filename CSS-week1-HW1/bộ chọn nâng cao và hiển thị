/* 1. Body */
body {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 16px;
}

/* 2. Header */
header {
    background-color: #d9eaf7;
}

/* 3. Navigation */
nav {
    display: inline-block;
    width: 80%;
    background-color: #e8e8e8;
}

/* 4. Chỉ định kiểu cho hình ảnh bên trong nav */
nav img {
    width: 10%;
}

/* 5. Main content */
main {
    background-color: #f5f5f5;
    font-size: 18px;
}

/* 6. Footer */
footer {
    background-color: #d9eaf7;
}

/* 7. Tạm chú thích kiểu cũ của li */
/*
